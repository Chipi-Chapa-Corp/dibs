{
  "name": "jeopardy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "play": "npm run build && npm start",
    "firewall:enable": "node scripts/enable-firewall.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "lucide-react": "^1.66.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/multer": "^2.3.0",
    "@types/qrcode": "^1.5.6"
  }
}
